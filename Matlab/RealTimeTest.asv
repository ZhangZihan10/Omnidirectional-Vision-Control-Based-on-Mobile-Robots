% 初始化客户端连接
name = "Matlab";
Client = TCPInit('127.0.0.1',55012,name);
% 加载相机模型
load('Omni_Calib_Results_Unity.mat'); 
ocam_model = calib_data.ocam_model;

cvsyst_rot = 0;      % 如果坐标系无旋转
cvsyst_y = 0;        % 相机坐标系 y 偏移
cvsyst_x = 0;        % 相机坐标系 x 偏移

camY = 0;          % Camera parameters 为x旋转
camX = 0;          % Camera parameters 为z旋转
camZ = 0;          % Camera parameters 为y旋转

lasY = 0.0;          % 激光器绕 Y 轴旋转
lasX = 0.0;          % 激光器绕 X 轴旋转

% --- 预取一帧图像，初始化图像句柄 ---
black_image = ImageReadTCP_One(Client, 'Center');
binaryImage = LaserFindRealtime(black_image);
% 第一次绘图，创建句柄
figure;
% 第一次绘图，创建句柄
f1 = subplot(1,3,1); h1 = imshow(black_image); title('Original Image');
f2 = subplot(1,3,2); h2 = imshow(binaryImage); title('Laser Extraction');
f3 = subplot(1,3,3);
h3 = scatter([], [], 5, 'filled'); hold on;
% 固定坐标轴范围
xlim([-10000, 10000]);
ylim([-1000, 4000]);
%h4 = plot(0, 0, 'r*'); % 保留红点绘图句柄
title('Ranging Results'); xlabel('X/cm'); ylabel('Y/cm'); grid on;
x = 0; y = 0; las_dist = 950; % 激光面参数

% 图像采集 + 实时处理循环
while true
    try
        % Step 1: 等待有效图像生成
        timeout = 2; tic;
        while true
            if exist('image.png', 'file') == 2
                file_info = dir('image.png');
                if file_info.bytes > 1000 % 避免读取空图
                    break;
                end
            end
            if toc > timeout
                warning('图像等待超时，跳过本帧。');
                continue;
            end
            pause(0.01);
        end
    % --- Step 1: 采集图像 ---
    image = ImageReadTCP_One(Client, 'Center'); % 获取图像
    black_image = image;

    % --- Step 2: 激光提取处理 ---
    %（可以封装为函数 processLaserImage(image)，返回 cleaned binaryImage）
    binaryImage = LaserFindRealtime(black_image);
    %imshow(binaryImage);

    % --- Step 3: Mapping & 坐标提取 ---
    
    [x1, y1] = mapping(binaryImage, cvsyst_rot, cvsyst_y, cvsyst_x, ...
                  camY, camX, camZ, lasY, lasX, las_dist, ocam_model);
    xy = [x1(:), y1(:)];
    xy(1,:) = [];  % 删除第一行
    [potNew,xt1,yt1] = MappingRobot(xy,450);
    %[C_Up] = cube_dist(binaryImage,[1;1850],[1;1850],x,y,las_dist,ocam_model);
    %[potNew,xt1,yt1] = MappingRobot(C_Up,450);

    % Step 4: 更新图像内容
    set(h1, 'CData', black_image);
    set(h2, 'CData', binaryImage);
    %set(h3, 'XData', xt1, 'YData', yt1);
    set(h3, 'XData', x1, 'YData', y1);
    %set(h4, 'XData', potNew(1), 'YData', potNew(2));
    %if ~isempty(potNew)
        % 如果有有效的机器人位置，则更新红点
    %    h4 = plot(potNew(1), potNew(2), 'r*');
    %end

    drawnow limitrate; % 提升性能
    catch ME
        warning('发生错误：%s，跳过本帧。', char(ME.message));
        continue;
    end

     % --- Step 5: 检测键盘按键退出 ---
    
end
